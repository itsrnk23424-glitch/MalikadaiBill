
name: Build Malikadai Android APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-debug-apk:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      # Download project source
      - name: Get the app source
        uses: actions/checkout@v4

      # Install Node.js
      - name: Install Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      # Install Java
      - name: Install Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      # Fixed Android SDK setup
      - name: Install Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools'

      # Install all app dependencies
      - name: Install JavaScript dependencies
        run: npm install --no-audit --no-fund

      # Test voice billing
      - name: Check multilingual voice billing
        run: npm run verify

      # Build app web files
      - name: Compile web screens
        run: npm run build

      # Create Android project
      - name: Create Android native project
        run: npx cap add android

      # Generate Android app icon
      - name: Generate Android app icon
        run: npx --yes @capacitor/assets@4.0.0 generate --android

      # Synchronize Android project
      - name: Sync Android project
        run: npx cap sync android

      # Add microphone permissions
      - name: Prepare Android microphone permissions
        run: node scripts/prepare-android-manifest.mjs

      # Build APK
      - name: Compile Android APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      # Verify the APK file
      - name: Verify APK
        run: |
          test -s android/app/build/outputs/apk/debug/app-debug.apk

      # Upload completed APK
      - name: Upload Android APK
        uses: actions/upload-artifact@v4
        with:
          name: MalikadaiBill-Android-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7
